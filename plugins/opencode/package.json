{
  "name": "heddle-opencode",
  "version": "0.1.0",
  "description": "opencode plugin: streams a coding-agent session to Matrix as structured dev.heddle.agent.v1 events, so heddle renders tool calls, results and diffs losslessly instead of recovering them from printed text.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "matrix",
    "heddle",
    "agent"
  ],
  "license": "Apache-2.0",
  "author": "Quintin De Kok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SynthSwarm/heddle.git",
    "directory": "plugins/opencode"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "npm run build && node test/fixtures.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "loglevel": "^1.9.2",
    "matrix-js-sdk": "^37.0.0",
    "node-indexeddb": "^6.0.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.13",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
